RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@yourdomain.com
CONTACT_TO_EMAIL=you@yourdomain.com

PLANSIGHT_IMPORT_SERVICE_URL=https://your-parser-service.example.com

# Public Supabase keys (browser + server reads).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only Supabase service-role key. Required for writes.
# NEVER prefix with NEXT_PUBLIC_; this must not reach the browser.
# Find it in Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Anthropic API key. Required for the AI analysis feature.
# NEVER prefix with NEXT_PUBLIC_; this must not reach the browser.
# Get one at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# Preview-only escape hatch for AI-analysis prompt iteration during MVP
# validation. When "true", bypasses the Pro gate on the Regenerate button
# so you can exercise fresh Claude calls without auth. NEVER set this on
# Production. Phase 4 replaces this with a real session.tier check.
NEXT_PUBLIC_PLANSIGHT_DEV_REGENERATE=
