# --- Resend (contact form email) ---
# Resend API key used to send contact-form emails.
RESEND_API_KEY=
# Sender address for contact-form emails (must be a verified Resend domain).
CONTACT_FROM_EMAIL=
# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL=

# --- PlanSight import service ---
# Base URL of the PlanSight import service.
PLANSIGHT_IMPORT_SERVICE_URL=

# --- Supabase ---
# Public Supabase keys (browser + server reads).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service-role key. Required for writes.
# NEVER prefix with NEXT_PUBLIC_; this must not reach the browser.
# Find it in Supabase dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic ---
# Server-only Anthropic API key. Required for the AI analysis feature.
# NEVER prefix with NEXT_PUBLIC_; this must not reach the browser.
# Get one at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# --- Google Analytics ---
# GA4 measurement ID (e.g. G-XXXXXXXXXX) for client-side analytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# --- Feature flags ---
# Preview-only escape hatch for AI-analysis prompt iteration during MVP
# validation. When "true", bypasses the Pro gate on the Regenerate button
# so you can exercise fresh Claude calls without auth. NEVER set this on
# Production. Phase 4 replaces this with a real session.tier check.
NEXT_PUBLIC_PLANSIGHT_DEV_REGENERATE=

# --- Booking ---
# Cal.com link used by every "Book a call" / "Book an intro call" button.
# Optional; defaults to https://cal.com/angelito-crisologo/30min when unset.
NEXT_PUBLIC_BOOKING_URL=
